# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_KEY"
# PAYU_MERCHANT_KEY: PayU Live/Sandbox Merchant Key (Provided in PayU Dashboard)
PAYU_MERCHANT_KEY="YOUR_PAYU_KEY"
# PAYU_MERCHANT_SALT: PayU Live/Sandbox Merchant Salt (Used to calculate SHA-512 Hash)
PAYU_MERCHANT_SALT="YOUR_PAYU_SALT"
